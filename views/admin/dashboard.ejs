<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>관리자 대시보드 | 마마트레이딩</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --naver-green: #03C75A;
            --bg-dark: #0F172A;
            --card-bg: #1E293B;
            --border-color: rgba(255, 255, 255, 0.12);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Noto Sans KR', sans-serif; }
        body { background: var(--bg-dark); color: #FFF; min-height: 100vh; }
        
        .header-bar {
            background: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .h-brand { font-size: 1.3rem; font-weight: 900; }
        .h-brand span { color: var(--naver-green); }
        .h-user { display: flex; align-items: center; gap: 14px; font-size: 0.9rem; }
        .btn-logout { background: rgba(255,255,255,0.1); color: #FFF; border: none; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
        .btn-logout:hover { background: #EF4444; }

        .container { max-width: 1280px; margin: 0 auto; padding: 30px 20px; }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 30px; }
        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 22px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .stat-card .s-num { font-size: 2rem; font-weight: 900; color: var(--naver-green); }
        .stat-card .s-title { font-size: 0.85rem; color: #94A3B8; margin-bottom: 4px; }

        /* Filter Controls */
        .filter-bar {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }
        .f-group { display: flex; align-items: center; gap: 10px; }
        .inp-search { background: rgba(255,255,255,0.06); border: 1px solid var(--border-color); color: #FFF; padding: 8px 14px; border-radius: 8px; font-size: 0.9rem; outline: none; width: 240px; }
        .sel-filter { background: rgba(255,255,255,0.06); border: 1px solid var(--border-color); color: #FFF; padding: 8px 14px; border-radius: 8px; font-size: 0.9rem; outline: none; cursor: pointer; }
        .sel-filter option { background: var(--card-bg); color: #FFF; }

        /* Applications Table */
        .table-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
        th { background: rgba(255,255,255,0.05); color: #94A3B8; padding: 14px 16px; font-weight: 700; border-bottom: 1px solid var(--border-color); }
        td { padding: 14px 16px; border-bottom: 1px solid var(--border-color); color: #E2E8F0; vertical-align: middle; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .st-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 800; }
        .st-PENDING { background: rgba(245, 158, 11, 0.2); color: #FBBF24; }
        .st-CONSULTING { background: rgba(59, 130, 246, 0.2); color: #60A5FA; }
        .st-APPROVED { background: rgba(16, 185, 129, 0.2); color: #34D399; }
        .st-REJECTED { background: rgba(239, 68, 68, 0.2); color: #F87171; }

        .btn-act { padding: 5px 10px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 700; }
        .btn-del { background: rgba(239, 68, 68, 0.2); color: #F87171; }
        .btn-del:hover { background: #EF4444; color: #FFF; }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .filter-bar { flex-direction: column; align-items: stretch; }
            .table-box { overflow-x: auto; }
        }
    </style>
</head>
<body>

    <header class="header-bar">
        <div class="h-brand">MAMA <span>ADMIN CONSOLE</span></div>
        <div class="h-user">
            <span><i class="bi bi-person-circle text-naver-green"></i> <strong><%= adminUser.name %></strong> 님</span>
            <button class="btn-logout" onclick="handleLogout()"><i class="bi bi-box-arrow-right"></i> 로그아웃</button>
        </div>
    </header>

    <main class="container">
        
        <!-- 4대 요약 통계 -->
        <div class="stats-grid">
            <div class="stat-card">
                <div>
                    <div class="s-title">누적 전체 접수</div>
                    <div class="s-num" id="stTotal">0</div>
                </div>
                <i class="bi bi-folder-check fs-2 text-naver-green"></i>
            </div>
            <div class="stat-card">
                <div>
                    <div class="s-title">오늘 신규 접수</div>
                    <div class="s-num" id="stToday" style="color: #60A5FA;">0</div>
                </div>
                <i class="bi bi-calendar-event fs-2 text-primary"></i>
            </div>
            <div class="stat-card">
                <div>
                    <div class="s-title">상담/심사 대기</div>
                    <div class="s-num" id="stPending" style="color: #FBBF24;">0</div>
                </div>
                <i class="bi bi-hourglass-split fs-2 text-warning"></i>
            </div>
            <div class="stat-card">
                <div>
                    <div class="s-title">최종 승인 완료</div>
                    <div class="s-num" id="stApproved" style="color: #34D399;">0</div>
                </div>
                <i class="bi bi-check-circle-fill fs-2 text-success"></i>
            </div>
        </div>

        <!-- 필터 컨트롤 바 -->
        <div class="filter-bar">
            <div class="f-group">
                <select id="statusFilter" class="sel-filter" onchange="loadApplications()">
                    <option value="ALL">전체 상태 보기</option>
                    <option value="PENDING">접수대기 (PENDING)</option>
                    <option value="CONSULTING">상담 진행 중 (CONSULTING)</option>
                    <option value="APPROVED">승인 완료 (APPROVED)</option>
                    <option value="REJECTED">부결/거절 (REJECTED)</option>
                </select>
                <input type="text" id="searchInput" class="inp-search" placeholder="성함 또는 연락처 검색" onkeyup="if(event.key==='Enter') loadApplications()">
                <button type="button" class="btn-logout" onclick="loadApplications()"><i class="bi bi-search"></i> 검색</button>
            </div>
            <button type="button" class="btn-logout" onclick="loadApplications()"><i class="bi bi-arrow-clockwise"></i> 새로고침</button>
        </div>

        <!-- 대출 신청 목록 테이블 -->
        <div class="table-box">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>신청자 성함</th>
                        <th>연락처</th>
                        <th>희망 금액</th>
                        <th>유입 경로</th>
                        <th>대출 유형</th>
                        <th>진행 상태</th>
                        <th>상담 메모</th>
                        <th>신청 일시</th>
                        <th>관리</th>
                    </tr>
                </thead>
                <tbody id="appTableBody">
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 40px; color: #94A3B8;">데이터를 불러오는 중입니다...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 유입 경로 & 시간대별 몰림 분석 센터 -->
        <div style="margin-top: 40px;">
            <h2 style="font-size: 1.3rem; margin-bottom: 20px; font-weight: 800;"><i class="bi bi-graph-up-arrow text-naver-green"></i> 유입 경로 & 시간대별 몰림 분석 센터</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                
                <!-- 7대 유입 채널 카운터 & 비율 -->
                <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 24px;">
                    <h3 style="font-size: 1.05rem; margin-bottom: 16px; color: #E2E8F0;"><i class="bi bi-compass"></i> 유입 경로별 분포 (인스타/페북/네이버/다음/구글/빙/직접)</h3>
                    <div id="channelProgressList" style="display: flex; flex-direction: column; gap: 12px;">
                        <!-- JS 렌더링 -->
                    </div>
                </div>

                <!-- 24시간 타임라인 몰림 피크 분석 -->
                <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 24px;">
                    <h3 style="font-size: 1.05rem; margin-bottom: 16px; color: #E2E8F0;"><i class="bi bi-clock-history"></i> 24시간 시간대별 신청 몰림 현황 (Peak Time)</h3>
                    <div style="height: 220px; position: relative;">
                        <canvas id="hourlyChart"></canvas>
                    </div>
                </div>

            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <!-- 일별 접수 추이 -->
                <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 24px;">
                    <h3 style="font-size: 1.05rem; margin-bottom: 16px; color: #E2E8F0;"><i class="bi bi-calendar-range"></i> 최근 7일 일별 접수 추이</h3>
                    <div style="height: 200px; position: relative;">
                        <canvas id="dailyChart"></canvas>
                    </div>
                </div>

                <!-- 월별 접수 추이 -->
                <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 24px;">
                    <h3 style="font-size: 1.05rem; margin-bottom: 16px; color: #E2E8F0;"><i class="bi bi-bar-chart-line-fill"></i> 월별 누적 접수 추이</h3>
                    <div style="height: 200px; position: relative;">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const token = localStorage.getItem('admin_token');
        let hourlyChartInstance = null;
        let dailyChartInstance = null;
        let monthlyChartInstance = null;

        // 통계 지표 불러오기
        async function loadStats() {
            try {
                const res = await fetch('/admin/api/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('stTotal').innerText = data.stats.total;
                    document.getElementById('stToday').innerText = data.stats.today;
                    document.getElementById('stPending').innerText = data.stats.pending;
                    document.getElementById('stApproved').innerText = data.stats.approved;
                }
            } catch (err) { console.error(err); }
        }

        // 신청 목록 불러오기
        async function loadApplications() {
            try {
                const status = document.getElementById('statusFilter').value;
                const keyword = document.getElementById('searchInput').value.trim();

                const res = await fetch(`/admin/api/applications?status=${status}&keyword=${encodeURIComponent(keyword)}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                const data = await res.json();
                const tbody = document.getElementById('appTableBody');

                if (!data.success || data.data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 40px; color: #94A3B8;">접수된 대출 신청건이 없습니다.</td></tr>`;
                    return;
                }

                tbody.innerHTML = data.data.map(item => {
                    const dateStr = new Date(item.created_at).toLocaleString('ko-KR');
                    const refSource = item.referer_source || '직접입력';
                    return `
                        <tr>
                            <td>#${item.id}</td>
                            <td><strong>${item.applicant_name}</strong></td>
                            <td>${item.applicant_phone}</td>
                            <td><strong style="color:#34D399">${item.desired_amount}</strong></td>
                            <td><span style="background:rgba(255,255,255,0.08); padding:3px 8px; border-radius:4px; font-size:0.8rem;">${refSource}</span></td>
                            <td>${item.loan_type || '일반대출'}</td>
                            <td>
                                <select class="sel-filter" style="padding:4px 8px; font-size:0.8rem;" onchange="updateStatus(${item.id}, this.value)">
                                    <option value="PENDING" ${item.status === 'PENDING' ? 'selected' : ''}>접수대기</option>
                                    <option value="CONSULTING" ${item.status === 'CONSULTING' ? 'selected' : ''}>상담중</option>
                                    <option value="APPROVED" ${item.status === 'APPROVED' ? 'selected' : ''}>승인완료</option>
                                    <option value="REJECTED" ${item.status === 'REJECTED' ? 'selected' : ''}>부결/거절</option>
                                </select>
                            </td>
                            <td>
                                <input type="text" value="${item.admin_memo || ''}" placeholder="메모 입력" class="inp-search" style="width:130px; padding:4px 8px; font-size:0.8rem;" onchange="updateMemo(${item.id}, '${item.status}', this.value)">
                            </td>
                            <td><span style="font-size:0.82rem; color:#94A3B8;">${dateStr}</span></td>
                            <td>
                                <button type="button" class="btn-act btn-del" onclick="deleteApp(${item.id})"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    `;
                }).join('');

            } catch (err) {
                console.error(err);
            }
        }

        // 유입 경로 분석 & 시간대별 몰림 리포트 렌더링
        async function loadAnalytics() {
            try {
                const res = await fetch('/admin/api/analytics', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (!data.success) return;

                // 1. 유입 경로 7대 채널 프로그래스 바
                const chStats = data.channelStats || {};
                const totalCount = Object.values(chStats).reduce((a, b) => a + b, 0) || 1;
                const container = document.getElementById('channelProgressList');
                
                const channelColors = {
                    '인스타그램': '#E1306C',
                    '페이스북': '#1877F2',
                    '네이버': '#03C75A',
                    '다음': '#FFCD00',
                    '구글': '#4285F4',
                    '빙': '#008373',
                    '직접입력': '#94A3B8'
                };

                container.innerHTML = Object.keys(chStats).map(ch => {
                    const cnt = chStats[ch] || 0;
                    const pct = ((cnt / totalCount) * 100).toFixed(1);
                    const color = channelColors[ch] || '#03C75A';

                    return `
                        <div>
                            <div style="display:flex; justify-shadow:space-between; justify-content:space-between; font-size:0.85rem; margin-bottom:4px;">
                                <span><strong style="color:${color}">${ch}</strong></span>
                                <span>${cnt}건 (${pct}%)</span>
                            </div>
                            <div style="background:rgba(255,255,255,0.08); height:8px; border-radius:4px; overflow:hidden;">
                                <div style="width:${pct}%; background:${color}; height:100%; transition:width 0.5s ease;"></div>
                            </div>
                        </div>
                    `;
                }).join('');

                // 2. 24시간 시간대별 몰림 차트 (Hour Peak Bar)
                const hourlyCtx = document.getElementById('hourlyChart').getContext('2d');
                if (hourlyChartInstance) hourlyChartInstance.destroy();

                const hoursLabels = Array.from({length: 24}, (_, i) => `${i}시`);
                hourlyChartInstance = new Chart(hourlyCtx, {
                    type: 'bar',
                    data: {
                        labels: hoursLabels,
                        datasets: [{
                            label: '신청 건수',
                            data: data.hourlyStats || [],
                            backgroundColor: '#03C75A',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { ticks: { color: '#94A3B8', fontSize: 10 }, grid: { display: false } },
                            y: { ticks: { color: '#94A3B8', precision: 0 }, grid: { color: 'rgba(255,255,255,0.06)' } }
                        }
                    }
                });

                // 3. 일별 접수 추이 차트 (Line Chart)
                const dailyCtx = document.getElementById('dailyChart').getContext('2d');
                if (dailyChartInstance) dailyChartInstance.destroy();

                const dLabels = (data.dailyStats || []).map(d => d.dt);
                const dData = (data.dailyStats || []).map(d => d.cnt);

                dailyChartInstance = new Chart(dailyCtx, {
                    type: 'line',
                    data: {
                        labels: dLabels.length > 0 ? dLabels : ['오늘'],
                        datasets: [{
                            label: '일별 신청건',
                            data: dData.length > 0 ? dData : [totalCount],
                            borderColor: '#38BDF8',
                            backgroundColor: 'rgba(56, 189, 248, 0.1)',
                            fill: true,
                            tension: 0.3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { ticks: { color: '#94A3B8' }, grid: { display: false } },
                            y: { ticks: { color: '#94A3B8', precision: 0 }, grid: { color: 'rgba(255,255,255,0.06)' } }
                        }
                    }
                });

                // 4. 월별 접수 추이 차트 (Bar Chart)
                const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
                if (monthlyChartInstance) monthlyChartInstance.destroy();

                const mLabels = (data.monthlyStats || []).map(m => m.ym);
                const mData = (data.monthlyStats || []).map(m => m.cnt);

                monthlyChartInstance = new Chart(monthlyCtx, {
                    type: 'bar',
                    data: {
                        labels: mLabels.length > 0 ? mLabels : ['이번 달'],
                        datasets: [{
                            label: '월별 신청건',
                            data: mData.length > 0 ? mData : [totalCount],
                            backgroundColor: '#A855F7',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { ticks: { color: '#94A3B8' }, grid: { display: false } },
                            y: { ticks: { color: '#94A3B8', precision: 0 }, grid: { color: 'rgba(255,255,255,0.06)' } }
                        }
                    }
                });

            } catch (err) {
                console.error(err);
            }
        }

        // 상태 변경
        async function updateStatus(id, newStatus) {
            try {
                const res = await fetch(`/admin/api/applications/${id}/status`, {
                    method: 'PATCH',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}` 
                    },
                    body: JSON.stringify({ status: newStatus })
                });
                const data = await res.json();
                if (data.success) {
                    loadStats();
                    loadAnalytics();
                }
            } catch (err) { alert('상태 변경 실패'); }
        }

        // 메모 변경
        async function updateMemo(id, currentStatus, memoTxt) {
            try {
                await fetch(`/admin/api/applications/${id}/status`, {
                    method: 'PATCH',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}` 
                    },
                    body: JSON.stringify({ status: currentStatus, adminMemo: memoTxt })
                });
            } catch (err) { alert('메모 저장 실패'); }
        }

        // 신청건 삭제
        async function deleteApp(id) {
            if (!confirm(`ID #${id} 신청건을 정말로 삭제하시겠습니까?`)) return;
            try {
                const res = await fetch(`/admin/api/applications/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    loadStats();
                    loadApplications();
                    loadAnalytics();
                }
            } catch (err) { alert('삭제 실패'); }
        }

        // 로그아웃
        async function handleLogout() {
            await fetch('/admin/api/logout', { method: 'POST' });
            localStorage.removeItem('admin_token');
            window.location.href = '/admin/login';
        }

        // 초기 실행
        loadStats();
        loadApplications();
        loadAnalytics();
    </script>
</body>
</html>
